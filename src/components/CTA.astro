---
---
<section class="section cta-section">
  <div class="container">
    <div class="cta-inner">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <h2>Ready to weave your knowledge together?</h2>
        <p>
          Connect your distributed teams and components into a unified, intelligent
          knowledge hub. Start with tecweave today.
        </p>
        <div class="cta-actions">
          <a href="mailto:info@tecweave.com" class="btn btn-primary">
            Get Early Access
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#architecture" class="btn btn-outline">Learn More</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--color-bg-alt);
  }

  .cta-inner {
    position: relative;
    border: 1px solid rgba(0, 194, 255, 0.2);
    border-radius: calc(var(--radius) * 1.5);
    padding: 4rem 2rem;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(0, 194, 255, 0.04), rgba(123, 94, 167, 0.06));
  }

  .cta-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(0, 194, 255, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .cta-content p {
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
