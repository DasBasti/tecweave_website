---
---
<section class="hero">
  <!-- Background grid -->
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-pattern"></div>
    <div class="glow-orb glow-1"></div>
    <div class="glow-orb glow-2"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Knowledge Hub for Modular Software
    </div>

    <h1>
      Weave your software<br />
      knowledge together with
      <span class="gradient-text"> tecweave</span>
    </h1>

    <p class="hero-description">
      tecweave unifies documentation from distributed teams and components into
      a single, intelligent knowledge graph — ingesting any format, processing
      with LLMs to find relations and contradictions, and validating that your
      docs actually match your software.
    </p>

    <div class="hero-actions">
      <a href="#architecture" class="btn btn-primary">
        Explore the Platform
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#services" class="btn btn-outline">See All Services</a>
    </div>

    <!-- Architecture flow preview -->
    <div class="hero-flow" aria-label="Data flow: Ingest → Process → Output">
      <div class="flow-step">
        <div class="flow-icon ingest">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <span>Ingest</span>
      </div>
      <div class="flow-connector" aria-hidden="true">
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none" aria-hidden="true">
          <path d="M0 8 L28 8" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
          <polyline points="24,4 30,8 24,12" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <div class="flow-step">
        <div class="flow-icon process">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
          </svg>
        </div>
        <span>LLM Process</span>
      </div>
      <div class="flow-connector" aria-hidden="true">
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none" aria-hidden="true">
          <path d="M0 8 L28 8" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
          <polyline points="24,4 30,8 24,12" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <div class="flow-step">
        <div class="flow-icon output">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </div>
        <span>Output</span>
      </div>
      <div class="flow-connector" aria-hidden="true">
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none" aria-hidden="true">
          <path d="M0 8 L28 8" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
          <polyline points="24,4 30,8 24,12" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <div class="flow-step">
        <div class="flow-icon validate">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <span>Validate</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 4rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 194, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 194, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
  }

  .glow-1 {
    width: 600px;
    height: 600px;
    top: -100px;
    right: -100px;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  }

  .glow-2 {
    width: 500px;
    height: 500px;
    bottom: -100px;
    left: -100px;
    background: radial-gradient(circle, var(--color-secondary) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgba(0, 194, 255, 0.08);
    border: 1px solid rgba(0, 194, 255, 0.2);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 680px;
    margin: 0 auto 2.5rem;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  /* Flow preview */
  .hero-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem 2rem;
    max-width: 760px;
    margin: 0 auto;
    box-shadow: var(--shadow-card);
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0 0.5rem;
  }

  .flow-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow-icon.ingest { background: rgba(0, 194, 255, 0.12); color: var(--color-primary); }
  .flow-icon.process { background: rgba(123, 94, 167, 0.15); color: var(--color-secondary); }
  .flow-icon.output { background: rgba(0, 255, 200, 0.1); color: var(--color-accent); }
  .flow-icon.validate { background: rgba(52, 211, 153, 0.1); color: #34d399; }

  .flow-connector {
    color: var(--color-border);
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .flow-connector {
      display: none;
    }

    .hero-flow {
      gap: 1rem;
    }
  }
</style>
